# ==============================================================================
# JobShield AI Monorepo Global Environment Variables
# ==============================================================================

# Application Environment Mode: 'development' | 'production'
NODE_ENV=development
FLASK_ENV=development

# Backend REST API Security & Database Configuration
SECRET_KEY=your-random-production-secret-key-at-least-32-chars
JWT_SECRET_KEY=your-random-production-jwt-secret-key-at-least-32-chars
JWT_EXPIRATION_MINUTES=60
DATABASE_URL=sqlite:///jobshield.db
NODE_ML_URL=http://127.0.0.1:5000/api/v1/analyze
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Web Application Configuration
# Production builds specify the public API gateway URL (defaults to '/api/v1')
VITE_API_URL=/api/v1

# Chrome Extension Configuration
# Production extension builds specify the deployed JobShield API URL
EXTENSION_API_URL=https://api.jobshield.ai/api/v1

