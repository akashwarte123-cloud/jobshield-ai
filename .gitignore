# ==============================================================================
# JobShield AI Monorepo Git Ignore Rules
# ==============================================================================

# Dependencies
node_modules/
.pnpm-store/
venv/
.venv/
env/
ENV/
__pycache__/
*.pyc
*.pyo
*.pyd

# Build Outputs & Generated Artifacts
dist/
build/
.output/
*.egg-info/
.eggs/
*.tsbuildinfo
apps/*/dist/
packages/*/dist/
apps/web/public/*.zip

# Databases & Local Storage
*.db
*.sqlite
*.sqlite3
postgres_data/
redis_data/
instance/

# Environment Files & Secrets (MUST NOT BE COMMITTED)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*
!.env.example
!backend/.env.example
*.pem
*.key
*.crt
*.pfx
secrets.json
credentials.json

# Logs & Temporary Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
scratch/
tmp/
temp/

# IDE & Operating System Files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# Testing & Coverage Caches
coverage/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/


extension/
