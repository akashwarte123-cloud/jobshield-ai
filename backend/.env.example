# ==============================================================================
# JobShield AI Backend Environment Variables
# ==============================================================================

# Application Environment Mode: 'development' | 'production' | 'testing'
FLASK_ENV=development
FLASK_APP=run.py
FLASK_DEBUG=True

# Flask & JWT Security Keys (REQUIRED IN PRODUCTION - Must be set to random secure strings)
# Production startup will FAIL if left as default fallbacks!
SECRET_KEY=dev-secret-key-jobshield-2026
JWT_SECRET_KEY=default-jwt-secret-jobshield-2026
JWT_EXPIRATION_MINUTES=60

# Database Configuration (SQLite by default, or PostgreSQL URI)
DATABASE_URL=sqlite:///jobshield.db

# Node.js ML Classifier Service Endpoint
NODE_ML_URL=http://127.0.0.1:5000/api/v1/analyze

# CORS Configuration (Comma-separated allowed origins; MUST be set in production)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

